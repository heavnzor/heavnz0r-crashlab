{
  "schema": "crashlab.scenario/v1",
  "name": "No-fault control",
  "objective": "Create exactly one issue for release-42 after checking approval.",
  "approved": true,
  "tools": [{
    "name": "create_issue", "description": "Create an issue. A stable idempotencyKey deduplicates identical retries.",
    "inputSchema": { "type": "object", "properties": { "requestId": { "type": "string" }, "title": { "type": "string" }, "idempotencyKey": { "type": "string" } }, "required": ["requestId", "title"], "additionalProperties": false },
    "effect": { "collection": "issues", "businessKey": "requestId", "dedupeKey": "idempotencyKey" }
  }],
  "faults": [],
  "invariants": [{ "kind": "unique", "collection": "issues", "by": "requestId" }, { "kind": "approval", "collection": "issues" }, { "kind": "count", "collection": "issues", "min": 1, "max": 1, "whenApproved": true }]
}
